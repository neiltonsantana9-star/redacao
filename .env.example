# Porta do servidor (padrão 4020; o Vite usa 5173 em desenvolvimento)
PORT=4020

# Segredo do JWT — defina em produção
JWT_SECRET=troque-por-um-segredo-forte

# Banco SQLite (padrão: server/data/redacoes.db)
# DB_PATH=

# ---- Análise ortográfica (LanguageTool público, sem chave) ----
# LANGUAGETOOL_URL=https://api.languagetool.org/v2/check

# ---- Análise de coesão/semântica por IA (opcional) ----
# Funciona com qualquer API compatível com OpenAI:
#   OpenAI  -> AI_API_URL=https://api.openai.com/v1  e AI_MODEL=gpt-4o-mini
#   DeepSeek -> AI_API_URL=https://api.deepseek.com/v1 e AI_MODEL=deepseek-chat
#   Ollama (local) -> AI_API_URL=http://localhost:11434/v1 e AI_MODEL=llama3
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Usar uma análise de IA "fake" local (sem chave) só para testar o fluxo
# MOCK_AI=1

# Credenciais do seed (npm run seed)
# SEED_EMAIL=professor@escola.com
# SEED_SENHA=prof123

# CORS (se o client for servido em outra origem): origens separadas por vírgula
# CORS_ORIGINS=http://localhost:5185

# ---- Produção (nuvem/hospedagem) ----
# Banco SQLite em disco/volume persistente:
# DB_PATH=/data/redacoes.db
#
# O app fica atrás de um proxy (ex.: Railway). O Express precisa confiar nele
# para gerar cookies seguros/HTTPS corretamente:
# TRUST_PROXY=1
#
# Cookies de sessão somente via HTTPS (recomendado em produção):
# AUTH_COOKIE_SECURE=1
#
# Bloqueia cadastro público (site de acesso restrito). Em produção defina como
# '0' se só o professor usar o painel; crie as contas via 'npm run seed' ou
# habilitando temporariamente o cadastro e desativando depois:
# ALLOW_REGISTER=0